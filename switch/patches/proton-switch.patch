+static inline uint16 FallbackUnaccented(uint16 ch)
+{
+	switch (ch) {
+		case 192: case 193: case 194: case 195: case 196: case 197: return 'A';
+		case 224: case 225: case 226: case 227: case 228: case 229: return 'a';
+		case 199: return 'C';
+		case 231: return 'c';
+		case 200: case 201: case 202: case 203: return 'E';
+		case 232: case 233: case 234: case 235: return 'e';
+		case 204: case 205: case 206: case 207: return 'I';
+		case 236: case 237: case 238: case 239: return 'i';
+		case 210: case 211: case 212: case 213: case 214: return 'O';
+		case 242: case 243: case 244: case 245: case 246: return 'o';
+		case 217: case 218: case 219: case 220: return 'U';
+		case 249: case 250: case 251: case 252: return 'u';
+		default: return ch;
+	}
+}
+
+static inline uint16 GetNextChar(const char* text, int len, int& i)
+{
+	uint8 b0 = (uint8)text[i];
+	if (b0 < 0x80)
+	{
+		return b0;
+	}
+	int seqLen = (int)utf8::internal::sequence_length<const char*>(&text[i]);
+	if (seqLen >= 2 && seqLen <= 3 && i + seqLen <= len && utf8::is_valid(&text[i], &text[i + seqLen]))
+	{
+		uint16 ch = 0;
+		try {
+			utf8::utf8to16<uint16*, const char*>(&text[i], &text[i + seqLen], &ch);
+			i += seqLen - 1;
+			return ch;
+		} catch (...) {
+			// fallback below
+		}
+	}
+	return b0;
+}
+
